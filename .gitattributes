# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force specific file types
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerignore text eol=lf

# Git config
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pkl binary
*.model binary
*.h5 binary
*.pt binary
